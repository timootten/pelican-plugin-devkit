# Local environment overrides
.env
.env.local

# Runtime data produced by the dev stack
/data/*
!/data/.gitkeep

# Each plugin is its own repository, cloned into plugins/<plugin-id>/
/plugins/*
!/plugins/.gitkeep

# Packaged plugin archives produced by `dev.php package`
/dist/

# Copy of the running panel's app/vendor, used only for IDE autocomplete
/panel-src/

# Editor / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp

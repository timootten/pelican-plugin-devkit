# Copy to `.env` to override any of the defaults baked into docker-compose.yml.
# Every value here is already the default - the stack boots fine without this file.

# --- Hostnames -------------------------------------------------------------
# These names must resolve to 127.0.0.1 on your machine AND to the container
# inside the Docker network (they are registered as network aliases).
# Run `php dev.php hosts` once to add them to your local hosts file.
#
# `.test` is reserved by RFC 6761 for local testing, so it never leaks to a
# public DNS server. `.localhost` is deliberately NOT used: libcurl - which the
# panel uses for its Wings API calls - hard-codes `*.localhost` to 127.0.0.1
# and would therefore never reach the Wings container.
PANEL_HOST=panel.pelican.test
WINGS_HOST=wings.pelican.test

# --- Published ports -------------------------------------------------------
PANEL_PORT=80
WINGS_PORT=8080
WINGS_SFTP_PORT=2022
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database --------------------------------------------------------------
POSTGRES_DB=panel
POSTGRES_USER=pelican
POSTGRES_PASSWORD=pelican

# --- Auto-provisioned admin account ---------------------------------------
ADMIN_EMAIL=admin@pelican.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# --- Auto-provisioned node -------------------------------------------------
NODE_NAME=local-wings
# Ports handed out to game servers. Wings publishes them on the Docker host,
# so they end up reachable on 127.0.0.1 from Windows.
ALLOCATION_IP=0.0.0.0
ALLOCATION_ALIAS=127.0.0.1
ALLOCATION_PORT_START=25565
ALLOCATION_PORT_END=25580

# --- Optional egg seeding --------------------------------------------------
# Comma separated egg names, looked up in the official Pelican egg index.
# Leave empty to skip (import is best effort and never fails provisioning).
PROVISION_EGGS=Vanilla Minecraft,Paper

# --- Auto-provisioned test server ------------------------------------------
# Creates one server on first start, owned by the admin account, using the
# first free allocation on the node. SERVER_EGG must be one of PROVISION_EGGS.
# Best effort - never fails provisioning, set PROVISION_SERVER=false to skip.
PROVISION_SERVER=true
SERVER_NAME=Paper Server
SERVER_EGG=Paper
SERVER_MEMORY=2048
SERVER_DISK=5120
SERVER_CPU=0

TZ=UTC
